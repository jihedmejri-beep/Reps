# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*

# Pipeline data: regenerated by `python run.py`, never committed.
data/raw/**
data/cleaned/**
data/merged/**
data/output/**
data/media/images/**
data/media/videos/**
data/logs/**
!data/raw/.gitkeep
!data/cleaned/.gitkeep
!data/merged/.gitkeep
!data/output/.gitkeep
!data/media/images/.gitkeep
!data/media/videos/.gitkeep
!data/logs/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
